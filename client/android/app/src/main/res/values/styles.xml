<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#6366F1</item>
        <item name="colorPrimaryDark">#0B0F1A</item>
        <item name="colorAccent">#8B5CF6</item>
        <item name="android:windowBackground">#0B0F1A</item>
        <item name="android:statusBarColor">#0B0F1A</item>
        <item name="android:navigationBarColor">#0B0F1A</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#0B0F1A</item>
        <item name="android:statusBarColor">#0B0F1A</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

</resources>
